#!/usr/bin/env bash
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
appdir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$appdir/result.sh"
case "${1:-install}" in
    -h|--help|help) exec /bin/bash "$appdir/usr/bin/rolimnet-wallpaper" "$@" ;;
esac
success='Operação concluída com sucesso.'
case "${1:-install}" in
    install) success='Instalação concluída com sucesso. Papel de parede aplicado. Atualizações automáticas a cada 1 hora.' ;;
    update|session) success='Papel de parede atualizado com sucesso.' ;;
    uninstall) success='Atualização automática desinstalada com sucesso. A imagem em uso foi preservada.' ;;
esac
run_with_result 'Wallpaper Rolimnet' "$success" /bin/bash "$appdir/usr/bin/rolimnet-wallpaper" "$@"
